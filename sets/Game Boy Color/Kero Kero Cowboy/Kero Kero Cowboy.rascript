// ~Homebrew~ Kero Kero Cowboy
// #ID = 34054

// --------------------------------------------------------
// MARK: HELPERS
// 
// --------------------------------------------------------
function has_increased(addr) => addr > prev(addr)
function has_decreased(addr) => addr < prev(addr)
function has_changed(addr) => addr != prev(addr)
function hasnt_changed(addr) => addr == prev(addr)
function if_else(p, t, f) { if (p) { return t } else return f }
function is_even(v) => v % 2 == 0
function bitflag(addr,f) => bit(f%8, addr + f/8)
function rp_num(x) => rich_presence_value("Number", x)

function ach(ach, t) {
    achievement(
        title = ach[0],
        points = ach[2],
        description = ach[1],
        trigger = ach[3],
        type=t
    )
}

// $C0BB: [8-bit] Player Tile X

// $C0BD: [8-bit] Player Tile Y

// $C0BE: [8-bit] Player Direction

// $C526: [24-bit] _current_scene
//        _current_scene is (in the engine) a struct defined as far_ptr_t which the first byte is the bank and the 2 next bytes is the pointer
//        When loading a scene the bank and pointer of the scene in ROM is stored in that.
function current_scene() => tbyte(0xc526)
